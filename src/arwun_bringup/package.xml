<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arwun_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and parameters that bring up the Arwun field data-collection rig.</description>
  <maintainer email="jaduncan86@gmail.com">roboav8r</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>arwun_description</exec_depend>
  <exec_depend>arwun_teleop</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>joy_linux</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
