# --- colcon ---
build/
install/
log/

# --- rosbag2 output ---
# Bags are large binary data; keep them out of the repo entirely. The default
# output_dir is ~/arwun_bags (outside the repo); these patterns cover the case
# where output_dir is pointed somewhere inside it.
bags/
arwun_bags/
rosbag2_*/
arwun_*T*/
*.db3
*.db3-shm
*.db3-wal
*.mcap

# --- vendored third-party sources ---
# librealsense is built from source here with -DFORCE_RSUSB_BACKEND=true so the
# D435i IMU is read over libusb; this Jetson kernel ships no hid_sensor_*/IIO
# modules, so the stock apt build enumerates no Motion Module and /camera/imu
# never publishes. Source tree + build artifacts are ~1GB -- rebuild with
# scripts/build_librealsense.sh rather than committing it.
vendor/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
venv/
.venv/

# --- editors / os ---
.vscode/
.idea/
*.swp
*~
.DS_Store

# --- misc ---
*.log
core
